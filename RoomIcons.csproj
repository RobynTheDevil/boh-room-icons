<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RoomIcons</AssemblyName>
    <RootNamespace></RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>dll\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- net472 and Private, deliberately: the game bundles no Harmony, so the mod must
       ship one, and net472 is the binary the other Book of Hours mods load. The
       netstandard lib folder NuGet would otherwise pick is an empty placeholder. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="0Harmony">
      <HintPath>$(PkgLib_Harmony)\lib\net472\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SecretHistories.Main">
      <HintPath>$(BohManaged)\SecretHistories.Main.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SecretHistories.Interfaces">
      <HintPath>$(BohManaged)\SecretHistories.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SecretHistories.Enums">
      <HintPath>$(BohManaged)\SecretHistories.Enums.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SecretHistories.Constants">
      <HintPath>$(BohManaged)\SecretHistories.Constants.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BohManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BohManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(BohManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BohManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(BohManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(BohManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BohManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FaceInfo and Glyph, used to measure text from the font asset's own metrics -->
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(BohManaged)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
